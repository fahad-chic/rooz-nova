rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // صور إعلانات حراج — قراءة عامة، وكتابة صور فقط حتى 10MB
    match /haraj_ads/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // بقية الملفات — قراءة عامة، كتابة للمسجلين فقط، مع حد حجم ونوع صورة
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
