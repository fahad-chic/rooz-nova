# =====================================================================
# أناقة ROOZ — متغيرات البيئة
# انسخ هذا الملف إلى .env ثم املأ القيم المطلوبة.
# لا ترفع ملف .env إلى Git نهائياً.
# =====================================================================


# ---------------------------------------------------------------------
# Firebase
# ---------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=


# ---------------------------------------------------------------------
# المالك والمشرف
# ---------------------------------------------------------------------
VITE_OWNER_EMAILS=
VITE_ADMIN_EMAILS=

# الرمز السري لبوابة المالك المخفية.
# يُستخدم للبوابة المخفية الخاصة بالمالك.
# اتركه فارغاً هنا، واضبطه في Cloudflare Pages Environment Variables.
VITE_OWNER_SECRET_CODE=


# ---------------------------------------------------------------------
# التواصل
# ---------------------------------------------------------------------
VITE_PHONE_1=
VITE_PHONE_2=
VITE_CONTACT_WHATSAPP_1=
VITE_CONTACT_WHATSAPP_2=


# ---------------------------------------------------------------------
# الحسابات البنكية
# ---------------------------------------------------------------------
VITE_BANK_RAJHI_NAME=
VITE_BANK_RAJHI_IBAN=
VITE_BANK_RAJHI_ACCOUNT=

VITE_BANK_ARABI_NAME=
VITE_BANK_ARABI_IBAN=
VITE_BANK_ARABI_ACCOUNT=


# ---------------------------------------------------------------------
# الذكاء الاصطناعي — Groq
# ---------------------------------------------------------------------
# هذا المفتاح سري ولا يجب استخدامه كمتغير VITE_.
GROQ_API_KEY=


# ---------------------------------------------------------------------
# شخصية المساعد
# ---------------------------------------------------------------------
ALIAA_NAME=
ALIAA_GREETING=
ALIAA_PERSONALITY=
ALIAA_OWNER=
ALIAA_ESTABLISHED=
ALIAA_LOCATION=
ALIAA_CONTACTS=


# ---------------------------------------------------------------------
# بيانات المتجر
# ---------------------------------------------------------------------
STORE_NAME=
STORE_DESCRIPTION=
STORE_POLICY=
STORE_WORKING_HOURS=

# عدد أيام سياسة الاستبدال/الإرجاع المستخدمة في الواجهة.
VITE_RETURN_POLICY_DAYS=7


# ---------------------------------------------------------------------
# التحقق عبر OTP
# ---------------------------------------------------------------------
# متغيرات الخادم — لا تستخدم VITE_ لأنها ليست مخصصة للواجهة.
OTP_ENFORCED=true
OTP_FROM_EMAIL=onboarding@resend.dev


# ---------------------------------------------------------------------
# Cloudflare Pages Functions
# ---------------------------------------------------------------------
# مفتاح Resend سري ويُضبط في Cloudflare Pages Environment Variables.
RESEND_API_KEY=

# D1 Database Binding
# يُضبط من لوحة Cloudflare Pages باسم:
# DB